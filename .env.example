# WERA reads secrets on the server only; the browser never sees a value.
# Never commit a real .env.local.

# Copy this file to .env.local in the repo root. Both processes read it: the agent reads it
# directly (wera_agent/settings.py) and Next.js loads it for the web app.

# --- Provider keys ----------------------------------------------------------------
# The agent service holds every provider key. The web app holds none.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
FIRECRAWL_API_KEY=
# Job discovery (SRCH-20): serper.dev answers Google searches over an API. The Strategist's
# queries go there; Firecrawl is only the last resort for reading a posting.
SERPER_API_KEY=
# Where discovered postings wait to be read. `brew install redis && brew services start redis`.
REDIS_URL=redis://127.0.0.1:6379/0
# Job-alert inbox (dedicated mailbox, read-only)
ALERTS_IMAP_HOST=
ALERTS_IMAP_USER=
ALERTS_IMAP_APP_PASSWORD=
ALERTS_FOLDER=WERA-alerts
# Demo mode uses fixtures and a mock model, and keeps its data in its own database (wera_demo).
WERA_DEMO_MODE=true
# Tracing (optional). Without a Logfire token nothing is sent, whatever this says.
# `logfire init` writes the token to .logfire/logfire_credentials.json; LOGFIRE_TOKEN overrides it.
# Both services read it: the agent reports as `wera-agent`, the web server as `wera-web`, and a
# request's trace runs across the two (apps/web/lib/server/telemetry.ts).
LOGFIRE_ENABLED=true
LOGFIRE_TOKEN=
# The archive (OBS-01) copies Logfire's records into Postgres, where they outlive Logfire's 30
# days. It needs a project *read* token: Logfire → the project → Settings → Read tokens. An
# organisation API key (pylf_v2_…) is not one, and the query API refuses it.
LOGFIRE_READ_TOKEN=
# Postgres is WERA's database (REL-04); SQLite is for the unit tests only. Unset, these default
# to postgresql://localhost/wera and postgresql://localhost/wera_demo. Demo mode has its own, so
# a demo can never write its sample jobs into the real data. Move an old SQLite install in with
# `uv run --project services/agent wera db import-sqlite data/wera.db`.
DATABASE_URL=postgresql://wera_app:<password>@localhost:5432/wera
DEMO_DATABASE_URL=postgresql://wera_app:<password>@localhost:5432/wera_demo
# For viewers and notebooks: a role that can only SELECT. WERA itself never reads this one.
WERA_READONLY_URL=postgresql://wera_readonly:<password>@localhost:5432/wera
# Postgres metrics (OBS-04): the login `scripts/otel-collector.sh` gives the collector. A role
# with pg_monitor and nothing else:  create role logfire_monitor login password '…';
#                                     grant pg_monitor to logfire_monitor;
POSTGRESQL_USERNAME=logfire_monitor
POSTGRESQL_PASSWORD=

# --- Both apps, only when you run them yourself instead of `pnpm dev` -------------
# `pnpm dev` generates a fresh token and sets these for both processes.
AGENT_URL=http://127.0.0.1:8787
AGENT_TOKEN=
