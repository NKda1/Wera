# Copy to apps/web/.env.local and fill in. Never commit .env.local.
# WERA reads these on the server only; the browser never sees a value.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
FIRECRAWL_API_KEY=
# Job-alert inbox (dedicated mailbox, read-only)
ALERTS_IMAP_HOST=
ALERTS_IMAP_USER=
ALERTS_IMAP_APP_PASSWORD=
ALERTS_FOLDER=WERA-alerts
WERA_DEMO_MODE=true
